{
  "$id": "urn:research:dvo:evidence-envelope:v1",
  "title": "DVO EvidenceEnvelope (wire form, v1.x)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": "1.0",
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "correlation": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "traceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parentEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "taskId",
        "traceId",
        "eventId",
        "idempotencyKey",
        "occurredAt"
      ]
    },
    "tier": {
      "default": 0,
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "taskScope": {
      "default": "",
      "type": "string",
      "maxLength": 8000
    },
    "claims": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "statement": {
            "type": "string",
            "maxLength": 4000
          },
          "confidence": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "assumptions": {
            "default": [],
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "dependencies": {
            "default": [],
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "status": {
            "default": "proposed",
            "type": "string",
            "enum": [
              "proposed",
              "supported",
              "verified",
              "refuted"
            ]
          }
        },
        "required": [
          "id",
          "statement"
        ]
      }
    },
    "evidence": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "citation",
              "tool-result",
              "test-result",
              "artifact",
              "observation"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "uri": {
            "type": "string",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mimeType": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}\\/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "verifierHint": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "kind",
          "summary"
        ]
      }
    },
    "requestedNextAction": {
      "type": "string",
      "maxLength": 1000
    },
    "redactionApplied": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "claims"
  ]
}
